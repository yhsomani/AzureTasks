{
  "name": "azure-3in1-task-creator",
  "version": "1.0.0",
  "description": "Production-quality Azure DevOps 3in1 Task auto-creation utility with duplicate prevention and relationship copying",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "create-tasks": "tsx src/index.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "ui": "tsx src/index.ts --ui",
    "serve": "tsx src/index.ts --ui",
    "daemon": "tsx src/index.ts --daemon",
    "build": "tsc && node -e \"require('fs').cpSync('src/ui', 'dist/ui', { recursive: true });\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "azure-devops",
    "automation",
    "wiql",
    "task-creator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
