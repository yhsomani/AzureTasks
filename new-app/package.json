{
  "name": "azure-3in1-task-creator",
  "version": "2.0.0",
  "description": "Azure DevOps 3in1 Task Studio - task planning, creation, audit and automation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=\"${NODE_EXTRA_CA_CERTS:-$(pwd)/certs/zscaler.pem}\" tsx watch src/index.ts",
    "start": "NODE_EXTRA_CA_CERTS=\"${NODE_EXTRA_CA_CERTS:-$(pwd)/certs/zscaler.pem}\" node dist/index.js",
    "build": "rm -rf dist && tsc && node -e \"import('fs').then(fs => fs.cpSync('src/presentation/web/public', 'dist/presentation/web/public', { recursive: true }))\" && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npx tsx tests/e2e/run-all-e2e.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "verify:staging:readonly": "node scripts/staging-readonly-verify.mjs",
    "state:backup": "node scripts/state-backup.mjs backup",
    "state:verify": "node scripts/state-backup.mjs verify",
    "state:restore": "node scripts/state-backup.mjs restore",
    "verify:schema:readonly": "node scripts/verify-azure-schema.mjs",
    "test:schema": "node --test scripts/verify-azure-schema.test.mjs",
    "verify:identities:readonly": "node scripts/verify-azure-identities.mjs",
    "test:identities": "node --test scripts/verify-azure-identities.test.mjs",
    "verify:workitems:readonly": "node scripts/verify-azure-workitems.mjs",
    "test:workitems": "node --test scripts/verify-azure-workitems.test.mjs"
  },
  "keywords": [
    "azure-devops",
    "automation",
    "wiql",
    "task-creator"
  ],
  "license": "ISC",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
