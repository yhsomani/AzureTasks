# Azure DevOps Personal Access Token (PAT)
# Required scopes:
#   - Work Items: Read & Write
AZURE_DEVOPS_PAT=your_azure_devops_pat_here

# GitHub Personal Access Token (for EOD Pull Request task description generation)
# Required scopes:
#   - repo (Full control of private repositories)
#   - read:org (Read org and team membership)
#   - read:user (Read user profile data for email fallback)
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=3in1-AppFrontEnd
GITHUB_USER_SUFFIX=_bflghec

# Optional overrides (fall back to people.json / defaults):
# AZURE_DEVOPS_ORG=BFLDevOpsOrg
# AZURE_DEVOPS_PROJECT=3in1_Agile_Projects
# AZURE_DEVOPS_TIMEZONE=Asia/Kolkata
# PORT=3000

# Automated End-of-Day (EOD) Task Auto-Closure Settings:
# Auto-closes today's tasks between 6:15 PM and 6:45 PM IST on weekdays with 8h completed, 0h remaining, and PR links.
AUTO_CLOSE=true
AUTO_CLOSE_START_TIME=18:15
AUTO_CLOSE_END_TIME=18:45

# Corporate proxy certificate verification:
# Use the PEM-encoded corporate CA certificate, when approved by IT.
# Never disable peer certificate validation.
# NODE_EXTRA_CA_CERTS=/path/to/trusted-corporate-ca.pem

# HTTP Basic auth for the web UI + API (required for production).
# Set a long random secret and deploy behind HTTPS; the user defaults to "admin".
# API_AUTH_TOKEN=choose-a-long-random-secret
# API_AUTH_USER=admin

# Cross-origin browser requests are disabled by default. Only set when necessary:
# CORS_ORIGIN=https://trusted-admin.example.com
