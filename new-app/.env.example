# ============================================================================
# AZURE DEVOPS CONFIGURATION (Required for all operations)
# ============================================================================
# Obtain a Personal Access Token from: https://dev.azure.com/{org}/_usersSettings/tokens
# Required scopes: Work Items (Read & Write)
# DO NOT commit real tokens - this file should only contain placeholder values
AZURE_DEVOPS_PAT=your-personal-access-token-here

# Azure DevOps Organization and Project
AZURE_DEVOPS_ORG=your-organization-name
AZURE_DEVOPS_PROJECT=your-project-name

# Timezone for date calculations (e.g., Asia/Kolkata, America/New_York, UTC)
AZURE_DEVOPS_TIMEZONE=UTC

# ============================================================================
# GITHUB CONFIGURATION (Optional - for PR-based evidence and generation)
# ============================================================================
# Obtain a token from: https://github.com/settings/tokens
# Required scopes: repo (full control), read:org, read:user
# Only required if GitHub evidence is needed
# GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=your-github-org
GITHUB_USER_SUFFIX=_suffix

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Listen host for the HTTP server
# For development: 127.0.0.1 (localhost only)
# For containers/production: explicitly set to 0.0.0.0 and firewall the port
LISTEN_HOST=127.0.0.1

# ============================================================================
# WORK ITEM AND TASK CONFIGURATION
# ============================================================================
WORK_ITEM_TYPE=3in1 Task
TASK_SERIES=your-task-series
TITLE_PREFIX="Task |"
START_TIME=09:30

# Thursday mode: CURRENT (this week) or NEXT (next week)
THURSDAY_MODE=CURRENT

# Skip weekend days (Saturday, Sunday)
SKIP_WEEKENDS=true

# Default work item state for new tasks
DEFAULT_STATE=New

# ============================================================================
# AUTO-CLOSURE CONFIGURATION (Be careful with this!)
# ============================================================================
# DANGER: When enabled, tasks will be automatically closed between specified times
# Only enable with explicit approval and testing
AUTO_CLOSE=false
AUTO_CLOSE_START_TIME=18:15
AUTO_CLOSE_END_TIME=18:45

# ============================================================================
# RETRY AND RESILIENCE CONFIGURATION
# ============================================================================
MAX_RETRIES=3
INITIAL_RETRY_DELAY_MS=1000

# ============================================================================
# AI AND GENERATION CONFIGURATION
# ============================================================================
DEFAULT_GENAI_ENABLED=No

# ============================================================================
# CORPORATE PROXY CONFIGURATION (if required)
# ============================================================================
# Provide a PEM-encoded certificate file for corporate proxy
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

# ============================================================================
# HTTP BASIC AUTHENTICATION (Required for production, recommended for dev)
# ============================================================================
# IMPORTANT: Generate a strong random secret with:
#   openssl rand -base64 32
# The service will not start in production without an API_AUTH_TOKEN
# DO NOT share or commit real tokens
# API_AUTH_TOKEN=your-strong-random-secret-here
# API_AUTH_USER=admin

# ============================================================================
# CROSS-ORIGIN AND ORIGIN CONFIGURATION
# ============================================================================
# PUBLIC_ORIGIN: The external URL where the application is hosted (for TLS termination)
#   Required when TLS is terminated upstream (e.g., by nginx)
#   Example: https://task-studio.example.com
# PUBLIC_ORIGIN=https://your-domain.example.com

# CORS_ORIGIN: Explicitly allow cross-origin requests from a specific origin
#   Only set when necessary for browser-based requests from other domains
#   Example: https://trusted-admin.example.com
# CORS_ORIGIN=https://trusted-origin.example.com

# ============================================================================
# READ-ONLY VIEWER ACCESS (Optional)
# ============================================================================
# If set, creates a read-only credential for audit/viewer access
# Must be different from the operator API_AUTH_TOKEN
# Viewer can: GET, HEAD, OPTIONS, view reports
# Viewer cannot: POST, PUT, PATCH, DELETE
# API_VIEWER_USER=auditor
# API_VIEWER_TOKEN=separate-strong-random-secret-here

# ============================================================================
# SECRET STORAGE MODE (Development only!)
# ============================================================================
# In production, inject secrets through your deployment system (Kubernetes secrets, etc.)
# For local-only development, you can enable local file storage
# WARNING: This stores unencrypted secrets on disk!
# SECRET_STORAGE_MODE=local-file

