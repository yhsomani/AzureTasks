# Azure DevOps Personal Access Token (PAT)
# Required scopes:
#   - Work Items: Read & Write
AZURE_DEVOPS_PAT=your_azure_devops_pat_here

# Optional overrides (fall back to people.json / defaults):
# AZURE_DEVOPS_ORG=BFLDevOpsOrg
# AZURE_DEVOPS_PROJECT=3in1_Agile_Projects
# AZURE_DEVOPS_TIMEZONE=Asia/Kolkata
# PORT=3000

# HTTP Basic auth for the web UI + API (recommended whenever not on localhost).
# Leave API_AUTH_TOKEN unset to disable auth; the user defaults to "admin".
# API_AUTH_TOKEN=choose-a-long-random-secret
# API_AUTH_USER=admin
